generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  USTADH
  ADMIN
}

/// Member gender. `OTHER` is the safe legacy default — those members keep
/// seeing the general (ALL) amal list.
enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Who an AmalItem applies to. Women's amals are kept separate from men's.
enum AmalAudience {
  ALL
  MALE
  FEMALE
}

enum CycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AmalCategory {
  SALAH
  QURAN
  DHIKR
  SUNNAH
  CHARACTER
  SERVICE
  SELF_DISCIPLINE
  READING
  OTHER
}

enum AmalInputType {
  BOOLEAN
  NUMBER
  MINUTES
  PAGES
  AYAT
  COUNT
  TEXT
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum DailyEntryStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum BookStatus {
  PLANNED
  READING
  COMPLETED
  PAUSED
}

type AmalResponse {
  amalItemId   String   @db.ObjectId
  valueBoolean Boolean?
  valueNumber  Float?
  valueText    String?
  score        Float
  maxScore     Float
}

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(MEMBER)
  isActive      Boolean  @default(true)
  /// Required at registration; drives which AmalItems the member receives.
  gender        Gender   @default(OTHER)
  /// Privacy switch (profile settings): when true, even ADMIN/USTADH cannot
  /// see this member's Amalnama. Turning it off restores full review access.
  hideAmalnama  Boolean  @default(false)
  joinedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions             Session[]
  accounts             Account[]
  cyclesCreated        Cycle[]          @relation("CycleCreator")
  dailyEntries         DailyAmalEntry[]
  reviewsReceived      UstadhReview[]   @relation("ReviewMember")
  reviewsWritten       UstadhReview[]   @relation("ReviewAuthor")
  books                Book[]
  readingLogs          BookReadingLog[]
  commentsReceived     AmalComment[]    @relation("AmalCommentMember")
  commentsWritten      AmalComment[]    @relation("AmalCommentAuthor")

  quranProgress        QuranProgress?

  @@index([role, isActive])
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId             String
  providerId            String
  userId                String    @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Cycle {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      CycleStatus @default(DRAFT)
  createdById String      @db.ObjectId
  createdBy   User        @relation("CycleCreator", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  entries     DailyAmalEntry[]
  reviews     UstadhReview[]

  @@index([status, startDate, endDate])
  @@index([createdById])
}

model AmalItem {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  titleBn      String
  titleEn      String?
  description  String?
  category     AmalCategory
  inputType    AmalInputType
  targetValue  Float?
  unit         String?
  points       Float         @default(1)
  order        Int
  isActive     Boolean       @default(true)
  isRequired   Boolean       @default(false)
  /// On a member's period (মাসিক) day this amal does not apply — it is shown
  /// as "—" in reports and never counts as missed. Ustad/Admin controls it.
  exemptOnPeriod Boolean     @default(false)
  /// `ALL` = everyone (default for the seeded list), `MALE`/`FEMALE` = only
  /// members of that gender receive this amal in their daily Amalnama.
  genderScope  AmalAudience  @default(ALL)
  specificDay  Weekday?
  /// Creator of the item. `null` means the system/admin seed default list.
  createdById  String?       @db.ObjectId
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([isActive, order])
  @@index([category, order])
  @@index([createdById])
}

/// Ustadh/Admin feedback left on a member's Amalnama.
model AmalComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  memberId  String   @db.ObjectId
  member    User     @relation("AmalCommentMember", fields: [memberId], references: [id], onDelete: Cascade)
  authorId  String   @db.ObjectId
  author    User     @relation("AmalCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId, createdAt])
  @@index([authorId])
}

model DailyAmalEntry {
  id                   String           @id @default(auto()) @map("_id") @db.ObjectId
  userId               String           @db.ObjectId
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleId              String           @db.ObjectId
  cycle                Cycle            @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  date                  DateTime
  status                DailyEntryStatus @default(DRAFT)
  responses             AmalResponse[]
  totalScore            Float            @default(0)
  maxPossibleScore      Float            @default(0)
  completionPercentage Float            @default(0)
  personalNote          String?
  /// Member marked this day as menstrual — prayer/fasting amals are exempt
  /// (shown as "—" in reports and never counted as missed).
  isPeriodDay           Boolean          @default(false)
  submittedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([userId, cycleId, date])
  @@index([cycleId])
  @@index([userId, cycleId])
  @@index([cycleId, date])
  @@index([userId, date])
}

model UstadhReview {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  cycleId           String   @db.ObjectId
  cycle             Cycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  memberId          String   @db.ObjectId
  member            User     @relation("ReviewMember", fields: [memberId], references: [id], onDelete: Cascade)
  reviewerId        String   @db.ObjectId
  reviewer          User     @relation("ReviewAuthor", fields: [reviewerId], references: [id])
  comment           String
  isVisibleToMember Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([memberId, cycleId, reviewerId])
  @@index([memberId, cycleId])
  @@index([reviewerId])
}

model Book {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  userId      String     @db.ObjectId
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  author      String?
  translator  String?
  publisher   String?
  totalPages  Int?
  status      BookStatus @default(PLANNED)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  readingLogs BookReadingLog[]

  @@index([userId, status])
}

model BookReadingLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  bookId    String   @db.ObjectId
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  pagesRead Int
  fromPage  Int?
  toPage    Int?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([bookId, date])
}

/// Per-user Quran reading tracker: where the reader stopped (resume across
/// devices) plus the cumulative set of global ayah numbers already read.
model QuranProgress {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Reader mode the user was in: "surah" | "juz"
  mode        String   @default("surah")
  /// Surah number currently open (always populated, also for juz mode)
  surah       Int      @default(1)
  /// Juz number when mode = "juz"
  juz         Int?
  /// Last read ayah inside `surah`
  ayahInSurah Int      @default(1)
  /// Last read global ayah number (1..6236) — canonical resume anchor
  globalAyah  Int      @default(1)

  /// Reading preferences restored together with the position
  viewMode    String?
  fontSize    String?
  reciter     String?

  /// Cumulative coverage: every global ayah number the user has read so far
  readAyahs   Int[]    @default([])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
